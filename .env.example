# Copy to .env and fill in: cp .env.example .env
# ElevenLabs agent ID and API key
AGENT_ID=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
BROWSER_USE_API_KEY=
# The Creao agent's capi_ key, and the agent's app ID
CREAO_API_KEY=
CREAO_AGENT_ID=
# Optional: leave empty to turn Sentry off
SENTRY_DSN=
# sim prints the shapes; serial drives the real board and needs SERIAL_PORT (e.g. /dev/tty.usbmodem1101)
BOARD=sim
SERIAL_PORT=
